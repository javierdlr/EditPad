HOST  = ppc-amigaos
CC    = $(HOST)-gcc
STRIP = $(HOST)-strip

TARGET  = EditPad
VERSION = 46
LASTREV = $(shell c:type $(TARGET)_rev.rev)

OPTIMIZE = -O2
DEBUG    = -gstabs -DDEBUG
DEFINES  = -D__USE_INLINE__
INCLUDES = -I. -ISDK:MUI/C/include
WARNINGS = -Wall -Wwrite-strings #-Werror

CFLAGS   = $(OPTIMIZE) $(DEBUG) $(DEFINES) $(INCLUDES) $(WARNINGS)
LDFLAGS  = 
LDLIBS   = 

#ifdef DEBUG
#LDLIBS += -ldebug
#endif

STRIPFLAGS = #-R.comment --strip-unneeded-rel-relocs


SRCS = EditPad.c Menu.c Events.c ArexxCmds.c Misc.c

OBJS = $(SRCS:.c=.o)


.PHONY: all
all: $(TARGET)

editpad_catalog.h: EditPad.cd
	catcomp $< cfile $@

EditPad.o: $(TARGET)_rev.h gui_editpad.h editpad.h menu.h editpad_catalog.h
Menu.o: menu.h editpad.h editpad_catalog.h
Events.o: $(TARGET)_rev.h gui_editpad.h editpad.h menu.h events.h editpad_catalog.h
ArexxCmds.o: arexxcmds.h editpad.h menu.h
Misc.o: misc.h editpad.h menu.h


$(TARGET): $(OBJS)
	$(CC) $(LDFLAGS) -o $@.debug $^ $(LDLIBS)
	C:Copy $@.debug $@ FORCE CLONE
#	$(STRIP) $(STRIPFLAGS) -o $@ $@.debug

%.catalog: %.ct catalogs/EditPad.cd
	-flexcat CATALOG $@ catalogs/EditPad.cd $<


.PHONY: catalogs
catalogs:
	flexcat EditPad.cd EditPad_ES.ct CATALOG catalogs/spanish/EditPad.catalog


.PHONY: clean
clean:
	rm -f $(TARGET) $(TARGET).debug *.o


.PHONY: revision
revision:
	bumprev -e si $(VERSION) $(TARGET)


.PHONY: bumpdate
bumpdate:
	bumprev -e si -r $(LASTREV) $(VERSION) $(TARGET)
